// Prisma schema for the dpdp-ai-scanner dashboard.
// Auth model (User/Account/Session/VerificationToken) follows the shape
// required by @auth/prisma-adapter for NextAuth's database session strategy.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(cuid())
  githubId String   @unique
  login         String
  name          String?
  email         String?   @unique
  emailVerified DateTime? // required by @auth/prisma-adapter's createUser contract, unused otherwise
  image         String?

  accounts       Account[]
  sessions       Session[]
  connectedRepos Repo[]    @relation("ConnectedBy")

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A GitHub repo that has been "connected" to the dashboard by some user.
// Access to view its scans is NOT stored here — it's checked live against
// GitHub's API for whoever is signed in, so this table never goes stale
// relative to actual GitHub repo permissions.
model Repo {
  id           String @id @default(cuid())
  githubRepoId String @unique // GitHub's numeric repo id; stable across renames
  owner        String
  name         String

  connectedById String
  connectedBy   User   @relation("ConnectedBy", fields: [connectedById], references: [id])

  apiKey ApiKey?
  scans  Scan[]

  createdAt DateTime @default(now())

  @@unique([owner, name])
}

// One active API key per repo, used by the GitHub Action to authenticate
// scan uploads. Only the scrypt hash is stored; the raw key is shown once
// at creation time and cannot be retrieved again (only rotated).
model ApiKey {
  id     String @id @default(cuid())
  repoId String @unique
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  keyHash   String // scrypt(rawKey), hex-encoded, salted
  keySalt   String // hex-encoded random salt
  keyPrefix String // first chars of the raw key: DB lookup id + UI display, never the secret itself

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([keyPrefix])
}

model Scan {
  id     String @id @default(cuid())
  repoId String
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  commitSha String
  branch    String?
  prNumber  Int?
  scanRoot  String

  totalCount  Int
  highCount   Int
  mediumCount Int
  lowCount    Int

  createdAt DateTime  @default(now())
  findings  Finding[]

  @@index([repoId, createdAt])
}

model Finding {
  id     String @id @default(cuid())
  scanId String
  scan   Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  file             String
  line             Int
  vendor           String
  matchedSignature String
  callSource       String
  payloadArgs      Json
  functionScope    String?

  riskLevel       String // HIGH | MEDIUM | LOW
  dataflowReasons Json // string[]
  obligations     Json // [{ id, title, description }]
  remediation     String

  @@index([scanId, riskLevel])
}
